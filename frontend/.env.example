# Base URL of the API this portal talks to. ONE origin serves both the
# auth endpoints (/auth/*) and the support endpoints (/support/*) — see
# INTEGRATION.md for the nginx split that makes that true when auth
# lives on the existing Client Portal backend.
VITE_SITE_BACKEND_URL=https://support.encryptionconsulting.com/api/v1

# Absolute URL of THIS portal. Handed to the auth backend as ?callback_url=
# for SSO/IdP logins (see handleSSOLogin in features/login/LoginForm.jsx),
# which redirects the browser back to it. Leaving it unset sends the string
# "undefined" as the callback and SSO logins fail.
VITE_SITE_FRONTEND_URL=https://support.encryptionconsulting.com
