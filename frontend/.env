# Relative on purpose: nginx serves the SPA and both API path families from
# ONE origin, so a relative base works whether the portal is reached at
# http://192.168.1.17, a hostname, or later https://support-ec.encryptionconsulting.com
# -- no rebuild needed when the domain changes.
VITE_SITE_BACKEND_URL=/api/v1

# Must be ABSOLUTE: it is handed to the auth backend as ?callback_url= for
# SSO/IdP logins, and the backend redirects the browser back to it.
VITE_SITE_FRONTEND_URL=https://encryption-support.encryptionconsulting.com
