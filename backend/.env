# EC Support Portal -- backend runtime config.
#
# NOTE: read by systemd as an EnvironmentFile, which does NOT understand a
# trailing "# comment" on a value line -- it would become part of the value.
# Full-line comments are fine; never put one after a value.
#
# CONTAINS A MAILBOX PASSWORD. Installed to /opt/ec-support/backend/.env as
# 0640 root:ecsupport by deploy/setup.sh. Keep it out of version control.

MONGO_URI=mongodb://127.0.0.1:27017/ec_support

AUTH_VALIDATE_URL=https://resourcehubapi.encryptionconsulting.com/api/v1/auth/validate

# ---- Microsoft 365 (Exchange Online) client submission --------------------
# STARTTLS on 587 is mandatory here: Exchange Online refuses AUTH on a
# cleartext session, and the mailer only calls starttls() when this is true.
SUPPORT_SMTP_HOST=smtp.office365.com
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USERNAME=sam@encryptionconsulting.com
SUPPORT_SMTP_PASSWORD=Puneet@123
SUPPORT_SMTP_STARTTLS=true
SUPPORT_SMTP_SSL=false

# Destination for the full case detail -- unchanged, this is the queue.
SUPPORT_INBOX=support@encryptionconsulting.com

# From MUST match the authenticated mailbox unless that account has been
# granted "Send As" on support@. Exchange Online otherwise rejects the
# message outright with 550 5.7.60 (SendAsDenied) and BOTH the support
# notification and the client acknowledgement fail. Once Send As is granted
# in the Exchange admin center, change this to support@ and restart.
SUPPORT_MAIL_FROM="Encryption Consulting Support <sam@encryptionconsulting.com>"

# Threading / plus-addressing domain -- independent of the From mailbox.
SUPPORT_MAIL_DOMAIN=encryptionconsulting.com

PORTAL_BASE_URL=https://encryption-support.encryptionconsulting.com
SUPPORT_ATTACHMENT_DIR=/var/lib/ec-support/attachments

# Same-origin via nginx, so no CORS headers are needed. Leave unset.
#PORTAL_ORIGIN=
