# ---- database ------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/ec_support

# ---- auth introspection ----------------------------------------------------
# The existing EC auth service's validate endpoint. The support backend
# forwards the client's bearer session here on each request (cached 60s).
AUTH_VALIDATE_URL=https://resourcehubapi.encryptionconsulting.com/api/v1/auth/validate

# ---- outbound mail ---------------------------------------------------------
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=25            # 2525 if that's your local relay
SUPPORT_SMTP_USERNAME=          # leave empty for an anonymous relay
SUPPORT_SMTP_PASSWORD=
SUPPORT_SMTP_STARTTLS=          # default: true iff username is set
SUPPORT_SMTP_SSL=false
SUPPORT_INBOX=support@encryptionconsulting.com
SUPPORT_MAIL_FROM=Encryption Consulting Support <support@encryptionconsulting.com>
SUPPORT_MAIL_DOMAIN=encryptionconsulting.com

# ---- portal ----------------------------------------------------------------
PORTAL_BASE_URL=https://support.encryptionconsulting.com
SUPPORT_ATTACHMENT_DIR=/var/lib/ec-support/attachments

# Only set if the SPA is served from a different origin than this API
# (the recommended nginx layout keeps them same-origin — leave unset).
#PORTAL_ORIGIN=https://support.encryptionconsulting.com
